# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must stay LF everywhere, or bash fails on the carriage returns.
*.sh text eol=lf

# FreeMind example maps are compared byte for byte, so git must never touch their line endings.
*.mm -text

# Sample diagram files and draw.io examples are compared byte for byte too.
*.adpsample -text
*.drawio -text

# The Gradle wrapper script must stay LF, or it fails on Linux and macOS.
gradlew text eol=lf

# The FBL conformance corpus and real files are compared byte for byte, at byte offsets.
fbl/testdata/** -text
