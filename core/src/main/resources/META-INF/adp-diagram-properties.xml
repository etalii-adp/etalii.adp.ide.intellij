<!-- Properties of diagrams (US3): the ADP Properties tool window, in-place editing, EditInPlace and ShowProperties. -->
<idea-plugin>
    <extensions defaultExtensionNs="etalii.adp">
        <diagramFeature implementation="etalii.adp.core.diagram.properties.PropertiesFeature"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="ADP Properties" factoryClass="etalii.adp.core.diagram.properties.PropertiesToolWindowFactory"
                    anchor="right" secondary="true" icon="AllIcons.Toolwindows.ToolWindowStructure"/>
    </extensions>

    <actions>
        <action id="etalii.adp.core.EditInPlace" class="etalii.adp.core.diagram.properties.EditInPlaceAction" text="Edit in Place"
                description="Edit the selected item's text on the canvas">
            <keyboard-shortcut keymap="$default" first-keystroke="F2"/>
            <add-to-group group-id="etalii.adp.core.DiagramPopup" anchor="first"/>
        </action>
        <action id="etalii.adp.core.ShowProperties" class="etalii.adp.core.diagram.properties.ShowPropertiesAction" text="Show Properties"
                description="Show the ADP Properties tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift P"/>
            <add-to-group group-id="etalii.adp.core.DiagramPopup" anchor="after" relative-to-action="etalii.adp.core.EditInPlace"/>
        </action>
    </actions>
</idea-plugin>
