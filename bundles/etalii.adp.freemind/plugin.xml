<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- FR-002: only .mm files whose root element is <map> are FreeMind maps. -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="etalii.adp.freemind.mindmap"
            name="FreeMind Mind Map"
            base-type="org.eclipse.core.runtime.xml"
            file-extensions="mm"
            priority="normal">
         <describer class="etalii.adp.freemind.MindMapContentDescriber"/>
      </content-type>
   </extension>

   <!-- FR-001, FR-003: bound by content type only, never by extension. -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="etalii.adp.freemind.editor"
            name="FreeMind Mind Map (ADP)"
            class="etalii.adp.freemind.ui.MindMapEditor"
            contributorClass="etalii.adp.core.AdpActionBarContributor"
            default="true">
         <contentTypeBinding contentTypeId="etalii.adp.freemind.mindmap"/>
      </editor>
   </extension>

   <extension point="org.eclipse.ui.contexts">
      <context
            id="etalii.adp.freemind.context"
            name="Editing FreeMind Mind Maps (ADP)"
            description="The visual page of the FreeMind Mind Map (ADP) editor has focus"
            parentId="org.eclipse.ui.contexts.window">
      </context>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category id="etalii.adp.freemind.commands" name="FreeMind Mind Map (ADP)"/>
      <command id="etalii.adp.freemind.addChild" categoryId="etalii.adp.freemind.commands" name="Add Child Node"/>
      <command id="etalii.adp.freemind.addSibling" categoryId="etalii.adp.freemind.commands" name="Add Sibling Node"/>
      <command id="etalii.adp.freemind.rename" categoryId="etalii.adp.freemind.commands" name="Rename Node"/>
      <command id="etalii.adp.freemind.delete" categoryId="etalii.adp.freemind.commands" name="Delete Node"/>
      <command id="etalii.adp.freemind.moveUp" categoryId="etalii.adp.freemind.commands" name="Move Node Up"/>
      <command id="etalii.adp.freemind.moveDown" categoryId="etalii.adp.freemind.commands" name="Move Node Down"/>
      <command id="etalii.adp.freemind.indent" categoryId="etalii.adp.freemind.commands" name="Move Under Previous Sibling"/>
      <command id="etalii.adp.freemind.outdent" categoryId="etalii.adp.freemind.commands" name="Move Up a Level"/>
      <command id="etalii.adp.freemind.toggleFold" categoryId="etalii.adp.freemind.commands" name="Fold / Unfold Branch"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="etalii.adp.freemind.addChild" class="etalii.adp.freemind.ui.handlers.AddNodeHandler:child">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.addSibling" class="etalii.adp.freemind.ui.handlers.AddNodeHandler:sibling">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.rename" class="etalii.adp.freemind.ui.handlers.RenameHandler">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.delete" class="etalii.adp.freemind.ui.handlers.DeleteHandler">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.moveUp" class="etalii.adp.freemind.ui.handlers.MoveNodeHandler:up">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.moveDown" class="etalii.adp.freemind.ui.handlers.MoveNodeHandler:down">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.indent" class="etalii.adp.freemind.ui.handlers.MoveNodeHandler:indent">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.outdent" class="etalii.adp.freemind.ui.handlers.MoveNodeHandler:outdent">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
      <handler commandId="etalii.adp.freemind.toggleFold" class="etalii.adp.freemind.ui.handlers.ToggleFoldHandler">
         <activeWhen><reference definitionId="etalii.adp.freemind.editorActive"/></activeWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.core.expressions.definitions">
      <definition id="etalii.adp.freemind.editorActive">
         <with variable="activePartId">
            <equals value="etalii.adp.freemind.editor"/>
         </with>
      </definition>
   </extension>

   <!-- Active only while the visual page has focus; the text page keeps the text editor's keys. -->
   <extension point="org.eclipse.ui.bindings">
      <key commandId="etalii.adp.freemind.addChild" sequence="INSERT" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.addChild" sequence="TAB" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.addSibling" sequence="CR" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.rename" sequence="F2" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.delete" sequence="DEL" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.moveUp" sequence="M1+ARROW_UP" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.moveDown" sequence="M1+ARROW_DOWN" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.indent" sequence="M1+ARROW_RIGHT" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.outdent" sequence="M1+ARROW_LEFT" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="etalii.adp.freemind.toggleFold" sequence="SPACE" contextId="etalii.adp.freemind.context" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <!-- The visual page registers its context menu as <editor id>.context. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:etalii.adp.freemind.editor.context?before=additions">
         <command commandId="etalii.adp.freemind.addChild" style="push"/>
         <command commandId="etalii.adp.freemind.addSibling" style="push"/>
         <separator name="etalii.adp.freemind.add" visible="true"/>
         <command commandId="etalii.adp.freemind.rename" style="push"/>
         <command commandId="etalii.adp.freemind.delete" style="push"/>
         <separator name="etalii.adp.freemind.change" visible="true"/>
         <command commandId="etalii.adp.freemind.moveUp" style="push"/>
         <command commandId="etalii.adp.freemind.moveDown" style="push"/>
         <command commandId="etalii.adp.freemind.indent" style="push"/>
         <command commandId="etalii.adp.freemind.outdent" style="push"/>
         <separator name="etalii.adp.freemind.move" visible="true"/>
         <command commandId="etalii.adp.freemind.toggleFold" style="push"/>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.newWizards">
      <category id="etalii.adp.newWizards" name="A Different Perspective (ADP)"/>
      <wizard
            id="etalii.adp.freemind.newWizard"
            name="FreeMind Mind Map"
            category="etalii.adp.newWizards"
            class="etalii.adp.freemind.ui.NewMindMapWizard">
         <description>Create a FreeMind mind map (.mm) with a single root node.</description>
      </wizard>
   </extension>

   <!-- FR-026: the Outline page comes from an adapter factory, so the core framework needs no hook. -->
   <extension point="org.eclipse.core.runtime.adapters">
      <factory
            adaptableType="etalii.adp.freemind.ui.MindMapEditor"
            class="etalii.adp.freemind.ui.MindMapOutlineAdapterFactory">
         <adapter type="org.eclipse.ui.views.contentoutline.IContentOutlinePage"/>
      </factory>
   </extension>

</plugin>
