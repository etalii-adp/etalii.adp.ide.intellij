<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>etalii.adp</id>
    <name>ADP: A Different Perspective</name>
    <vendor url="https://etalii.net/adp">EtAlii</vendor>
    <idea-version since-build="262"/>

    <description><![CDATA[
    <p><img src="https://etalii.net/adp/favicon.svg" width="96" height="96" alt="The ADP mark: one model seen as text and as a diagram"></p>
    <p><b>The right view for every task.</b> ADP (A Different Perspective) is a family of specialized
    diagram, designer and text editors, each tuned for one task where a specialized visualization beats
    a generic diagram or plain text.</p>
    <p>Each designer is an editor on the file's own text, with the IDE's undo, redo, save and text view,
    so what it shows stays in plain files that can be reviewed, branched and merged like any other text.
    This plug-in brings two designers, edited with a shared toolbox and property panel:</p>
    <ul>
      <li>FreeMind mind maps (<code>.mm</code>)</li>
      <li>draw.io diagrams (<code>.drawio</code>)</li>
    </ul>
    <p>Documentation and the other ADP hosts: <a href="https://etalii.net/adp">etalii.net/adp</a>.
    Licensed under the Apache License, Version 2.0.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- Each part registers its own contributions; an absent part is simply skipped. -->
    <xi:include href="/META-INF/adp-core.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-freemind-editor.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-freemind-editing.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-freemind-new.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-diagram.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-diagram-editing.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-diagram-properties.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-diagram-navigation.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-drawio.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-settings.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-settings-designers.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-settings-canvas.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
    <xi:include href="/META-INF/adp-settings-designer-pages.xml" xpointer="xpointer(/idea-plugin/*)"><xi:fallback/></xi:include>
</idea-plugin>
